{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dashi-taskboard",
  "main": "cloud/src/index.mjs",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codex-taskboard-db",
      "migrations_dir": "cloud/migrations",
      "database_id": "ed72dd1f-b234-4393-a1b8-ee0a4d35a049"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-realtime-hub",
      "new_sqlite_classes": [
        "RealtimeHub"
      ]
    }
  ],
  "account_id": "29a673511975a847e1ab66dba5bb0b72"
}
